mkdir -p ~/.hammerspoon && printf 'local D=false;local E=102;local K=104;local L=56;local M=55;local N=54;local O=58;local P=61;local Q=93;local R=179;local S=0.22;local T="com.apple.keylayout.ABC";local U="com.apple.inputmethod.TCIM.Cangjie";local V={{title="📧 我的電子郵件",text="myemailk@gmail.com"},{title="🏢 公司統一編號",text="12345678"},{title="📍 常用寄件地址",text="台北市信義區信義路五段7號"},{title="✍️ 常用客套回覆",text="收到，感謝您的協助！我會盡快確認後回覆您。"}};local W={["com.apple.Notes"]=true,["com.apple.Terminal"]=false,["com.qvacua.VimR"]=false,["com.mitchellh.ghostty"]=false,["com.coteditor.CotEditor"]=false,["jp.naver.line.mac"]=true,["net.machorro.roberto.Moped"]=true,["com.apple.appkit.xpc.openAndSavePanelService"]=true,["com.apple.print.PrinterProxy"]=true,["com.sublimetext.4"]=false};local X=0.2;local Y=0;local Z={};local _=10;local a=hs.pasteboard.changeCount();clipboardTimer=hs.timer.doEvery(0.5,function()local b=hs.pasteboard.changeCount()if b~=a thenlocal c=hs.pasteboard.getContents()if c and c~="" thenlocal d=false;for e,f in ipairs(V)do if c==f.text then d=true;break end end;if not d and c~=Z then table.insert(Z,1,c)if #Z>_ then table.remove(Z)end end end;a=b end end):start();local function g()local h={}for e,f in ipairs(V)do table.insert(h,{text=f.title,subText=f.text,actualText=f.text})end;for i,j in ipairs(Z)do local k=string.gsub(j,"[\\r\\n]"," ")if string.len(k)>40 then k=string.sub(k,1,40).."..." end;table.insert(h,{text=string.format("[%d] 📋 %s",i,k),subText=j,actualText=j})end;if #h==0 then hs.alert.show("📭 選單目前沒有內容")return end;if myChooser then myChooser:delete()end;myChooser=hs.chooser.new(function(l)if l then hs.pasteboard.setContents(l.actualText)hs.timer.doAfter(0.02,function()hs.eventtap.keyStroke({"cmd"},"v",0)end)end end);myChooser:choices(h)myChooser:placeholderText("輸入關鍵字可模糊搜尋常用字或剪貼簿...")myChooser:show()end;local function m()local n=hs.timer.secondsSinceEpoch()if n-Y<X then return end;Y=n;hs.eventtap.keyStroke({"ctrl"},"space",10000)end;local function o(p)local q=hs.application.frontmostApplication()local r=q and q:bundleID() or ""if r=="com.apple.Safari" then local s=hs.keycodes.currentSourceID()if s~=p then m()end else hs.keycodes.currentSourceID(p)end end;local t=0;kanaTap=hs.eventtap.new({hs.eventtap.event.types.keyDown},function(u)local keyCode=u:getKeyCode()local flags=u:getFlags()if keyCode==K then if flags.alt then hs.eventtap.keyStroke({"cmd","shift"},"2",0)return true end;if flags.cmd then hs.eventtap.keyStroke({"cmd","shift"},"4",0)return true end;local n=hs.timer.secondsSinceEpoch()if n-t<S then m();t=0 else o(U);t=n end;return true end;return false end):start();local v=0;eisuuTap=hs.eventtap.new({hs.eventtap.event.types.keyDown},function(u)local keyCode=u:getKeyCode()local flags=u:getFlags()if keyCode==E then if flags.alt then hs.eventtap.keyStroke({"cmd","shift"},"1",0)return true end;if flags.cmd then hs.eventtap.keyStroke({"cmd","shift"},"3",0)return true end;local n=hs.timer.secondsSinceEpoch()if n-v<S then g();v=0 else hs.keycodes.currentSourceID(T);v=n end;return true end;return false end):start();local w=0;local x=nil;local y=0;local z=nil;modifierTap=hs.eventtap.new({hs.eventtap.event.types.flagsChanged},function(u)local keyCode=u:getKeyCode()local flags=u:getFlags()if keyCode==LSHIFT_KEY and flags.shift and flags.cmd then m();return true end;if keyCode==M or keyCode==RCMD_KEY then if flags.cmd and not flags.shift and not flags.ctrl and not flags.alt then if x then x:stop()end;w=w+1;if w==1 then x=hs.timer.doAfter(S,function()w=0 end)elseif w==2 then w=0;hs.eventtap.keyStroke({"cmd","shift"},"5",0);return true end end end;if keyCode==LALT_KEY or keyCode==RALT_KEY then if flags.alt and not flags.cmd and not flags.shift and not flags.ctrl then if z then z:stop()end;y=y+1;if y==1 then z=hs.timer.doAfter(S,function()y=0 end)elseif y==2 then y=0;hs.eventtap.keyStroke({"cmd","shift"},"8",0);return true end end end;return false end):start();screenshotKeyTap=hs.eventtap.new({hs.eventtap.event.types.keyDown},function(u)local keyCode=u:getKeyCode()local flags=u:getFlags()if keyCode==Q and flags.cmd then hs.eventtap.keyStroke({"cmd","shift"},"7",0);return true end;return false end):start();appWatcher=hs.application.watcher.new(function(A,B,C)if B==hs.application.watcher.activated then if C then local r=C:bundleID()local d=W[r] or false;if not d then hs.timer.doAfter(0.05,function()hs.keycodes.currentSourceID(T)end)end end;hs.timer.doAfter(0.1,function()if not hs.eventtap.isSecureInputEnabled() then if kanaTap then kanaTap:stop();kanaTap:start()end;if eisuuTap then eisuuTap:stop();eisuuTap:start()end;if modifierTap then modifierTap:stop();modifierTap:start()end;if screenshotKeyTap then screenshotKeyTap:stop();screenshotKeyTap:start()end end end)end end):start();secureInputTimer=hs.timer.doEvery(3,function()if not hs.eventtap.isSecureInputEnabled() then if kanaTap and not kanaTap:isEnabled() then kanaTap:start()end;if eisuuTap and not eisuuTap:isEnabled() then eisuuTap:start()end;if modifierTap and not modifierTap:isEnabled() then modifierTap:start()end;if screenshotKeyTap and not screenshotKeyTap:isEnabled() then screenshotKeyTap:start()end end end):start();keyLogger=hs.eventtap.new({hs.eventtap.event.types.keyDown},function(u)if D then local keyCode=u:getKeyCode()local flags=u:getFlags()print(string.format("Key Code: %%s | Modifiers: %%s",keyCode,hs.inspect(flags)))end;return false end):start();testWatcher=hs.application.watcher.new(function(A,B,C)if B==hs.application.watcher.activated and C and D then print("App名稱: "..A.." | BundleID: "..tostring(C:bundleID()))end end):start();hs.hotkey.bind({"alt","cmd"},"M",function()hs.application.launchOrFocus("CotEditor")hs.timer.doAfter(0.25,function()local q=hs.application.frontmostApplication()if q and q:name() == "CotEditor" then hs.eventtap.keyStroke({"cmd"},"n",0)hs.timer.doAfter(0.1,function()hs.eventtap.keyStroke({"cmd"},"v",0);hs.alert.show("📝 成功安全建立未命名新檔！",1)end)else hs.alert.show("⚠️ 視窗聚焦失敗，請再試一次",2)end end)end);local E_APP={["YouTube"]=true,["Google Chrome"]=true,["Safari"]=true,["Microsoft Edge"]=true,["Brave Browser"]=true};local function isYT()local q=hs.application.frontmostApplication()if not q or not E_APP[q:title()] then return false end;local win=q:focusedWindow()if win and string.find(win:title(),"YouTube") then return true end;return false end;local F_TIME=0;fnTap=hs.eventtap.new({hs.eventtap.event.types.keyDown,hs.eventtap.event.types.flagsChanged},function(u)local keyCode=u:getKeyCode()if keyCode==R then local n=hs.timer.secondsSinceEpoch()if n-F_TIME>0.05 then if n-F_TIME<0.38 then if isYT() then hs.eventtap.keyStroke({},"g",0)hs.timer.doAfter(0.05,function()hs.eventtap.keyStroke({},"h",0)end)hs.alert.show("📺 已自動返回 YouTube 首頁")end;F_TIME=0;return true else F_TIME=n end end end;return false end):start();arrowTap=hs.eventtap.new({hs.eventtap.event.types.keyDown},function(u)local flags=u:getFlags()local keyCode=u:getKeyCode()if flags.fn and isYT() then if keyCode==121 or keyCode==125 then hs.eventtap.keyStroke({},"f",0);return true elseif keyCode==116 or keyCode==126 then hs.eventtap.keyStroke({},"escape",0);return true elseif keyCode==124 then hs.eventtap.keyStroke({},"tab",0);return true elseif keyCode==123 then hs.eventtap.keyStroke({"shift"},"tab",0);return true end end;return false end):start();hs.autoLaunch(true);hs.alert.show("✨ Hammerspoon 終極優化配置已成功無損寫入！ 📺")' > ~/.hammerspoon/init.lua && echo "✨ 成功：本地端已 100% 無損完成部署！"
